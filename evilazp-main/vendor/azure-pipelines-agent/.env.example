url: https://dev.azure.com/<org>
pat: <azure-devops-pat>
pool: <agent-pool>
agent: <agent-name>

# Required only when building with `--tunnel`.
sp_tenant: <entra-tenant-id>
sp_client: <service-principal-client-id>
sp_secret: <service-principal-client-secret>
tunnel_id: <dev-tunnel-id>
tunnel_ports: 22,3389

# Required only when building with `--relay`.
relay_connection_string: "Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>"

# Local forward: listen locally on the target host and bridge to an Azure Relay
# Hybrid Connection. Format: <local-port>:<hybrid-connection>
relay_local_forward:
  - 8080:web-local

# Remote TCP forward: expose a target host:port through a Hybrid Connection.
# Format: <hybrid-connection>:<target-host>:<target-port>
relay_remote_forward:
  - ssh-remote:127.0.0.1:22

# Remote HTTP forward.
# Format: <hybrid-connection>:http/<target-host>:<target-port>
relay_remote_http_forward:
  - web-remote:http/127.0.0.1:8080

# Required only when using Azure Files commands in the interactive shell.
# Share and file paths are passed as command arguments, for example:
# /upload --target local ./local.txt /<share-name>/path/local.txt
# /download --target agent /<share-name>/path/remote.txt /tmp/remote.txt
# /azure-files list --share /<share-name>/path
azure_files_account: <storage-account-name>
azure_files_sas: "<sas-token>"

# Required only when using `/azure-files sas`.
azure_files_account_key: "<storage-account-key>"
