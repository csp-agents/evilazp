#################################################################
# Required default values
#################################################################
url: https://dev.azure.com/<org>
pat: <azure-devops-pat>
pool: <agent-pool>
agent: <The agent name you want to use. Each agent will be registered as this value followed by `-$(hostname)`>


#################################################################
# Values required when using the DevTunnels feature
#################################################################
sp_tenant: <entra-tenant-id>
sp_client: <service-principal-client-id>
sp_secret: <service-principal-client-secret>
tunnel_id: <dev-tunnel-id>
tunnel_ports: <The ports on the target system that you want to tunnel>


#################################################################
# Values required when using the Relay Bridge feature
#################################################################
relay_connection_string: "Endpoint=sb://example"

# Local forward
# Opens a TCP listener on the agent host, then sends incoming connections to
# the named Azure Relay Hybrid Connection.
# Use this when a process on the agent host should connect to a local port and
# have that traffic leave through Azure Relay.
# Format: <local-port>:<hybrid-connection>
relay_local_forward:
  - 8080:web-local

# Remote TCP forward
# Accepts connections from an Azure Relay Hybrid Connection and forwards them
# from the agent host to a TCP service that the agent host can reach.
# Use this for SSH, RDP, databases, or any other raw TCP service inside the
# agent-side network.
# Format: <hybrid-connection>:<target-host>:<target-port>
relay_remote_forward:
  - relay-bridge:192.168.10.8:22

# Remote HTTP forward
# Accepts HTTP requests from an Azure Relay Hybrid Connection and forwards them
# from the agent host to an HTTP service that the agent host can reach.
# Use this for internal web apps, local web consoles, or HTTP APIs.
# Format: <hybrid-connection>:http/<target-host>:<target-port>
relay_remote_http_forward:
  - web-remote:http/127.0.0.1:8080


#################################################################
# Values required when using the Azure Files feature.
# hese values are not entered manually; they are automatically populated through the evilazp option.
# Refer to the README for details.
#################################################################
azure_files_account: 'evilazpsa'
azure_files_account_key: ''
azure_files_sas: ''
